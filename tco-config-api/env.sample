PORT=8787
DATA_DIR=./data
ALLOW_DEV_AUTH=false
ADMIN_EMAILS=deanh@nvidia.com
REQUIRED_EMAIL_DOMAIN=
ALLOWED_ORIGINS=https://rdeanharris.github.io,http://127.0.0.1:8767
PUBLIC_API_BASE_URL=https://tco-api.example.com
APP_REDIRECT_URI=https://rdeanharris.github.io/Dean-Harris-Auto-gpu-sku-upgrade-tco-calculator/GPU_RA_and_NVAIE_TCO_Analysis.html
MAGIC_LINK_MINUTES=30
INVITE_APPROVAL_HOURS=24
SESSION_HOURS=12
COOKIE_AUTH_ENABLED=true
SESSION_COOKIE_NAME=autotco_session
COOKIE_SECURE=true
EMAIL_FROM=GPU TCO Access <no-reply@example.com>
EMAIL_DELIVERY_WEBHOOK_URL=https://email-service.example.com/send
EMAIL_DELIVERY_BEARER_TOKEN=replace-in-secret-manager
# Instead of the webhook, Microsoft Graph can send from an approved mailbox.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=

# Authoritative cloud GPU pricing source. Keep credentials only on this API server.
DATABRICKS_HOST=https://nvidia-edsp-fdp-prd.cloud.databricks.com
DATABRICKS_TABLE=edsp_fdp_nala_fpa_prod.gpu_cloud_model.unified_dataset_automotive
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
# Optional column overrides. Leave blank to use schema-based detection.
DATABRICKS_SKU_COLUMN=
DATABRICKS_PRICE_COLUMN=
DATABRICKS_PROVIDER_COLUMN=
DATABRICKS_MAX_ROWS=10000
DATABRICKS_CACHE_MINUTES=60
